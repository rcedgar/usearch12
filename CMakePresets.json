{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "out/build/${presetName}",
            "installDir": "out/install/${presetName}"
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "windows",
            "hidden": true,
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            }
        },
        {
            "name": "windows-x64",
            "hidden": true,
            "inherits": "windows",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "Win-x64-Debug",
            "inherits": [
                "base",
                "windows-x64",
                "debug"
            ]
        },
        {
            "name": "Win-x64-Release",
            "inherits": [
                "base",
                "windows-x64",
                "release"
            ]
        },
        {
            "name": "linux",
            "hidden": true,
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Linux"
                    ]
                }
            }
        },
        {
            "name": "linux-ci",
            "inherits": [
                "base",
                "debug",
                "linux"
            ]
        },
        {
            "name": "linux-release",
            "inherits": [
                "base",
                "release",
                "linux"
            ]
        },
        {
            "name": "linux-arm64-ci",
            "inherits": [ "linux-ci" ],
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "aarch64"
            }
        },
        {
            "name": "linux-arm64-release",
            "inherits": [ "linux-release" ],
            "cacheVariables": {
                "CMAKE_SYSTEM_PROCESSOR": "aarch64"
            }
        },
        {
            "name": "macos",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_OSX_DEPLOYMENT_TARGET": "10.14"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "macOS"
                    ]
                }
            }
        },
        {
            "name": "macos-ci",
            "inherits": [
                "base",
                "debug",
                "macos"
            ]
        },
        {
            "name": "macos-release",
            "inherits": [
                "base",
                "release",
                "macos"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "windows-ci",
            "configurePreset": "Win-x64-Debug",
            "targets": "usearch12"
        },
        {
            "name": "windows-release",
            "configurePreset": "Win-x64-Release",
            "targets": "usearch12"
        },
        {
            "name": "linux-ci",
            "configurePreset": "linux-ci",
            "targets": "usearch12"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "targets": "usearch12"
        },
        {
            "name": "linux-arm64-ci",
            "configurePreset": "linux-arm64-ci",
            "targets": "usearch12"
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64-release",
            "targets": "usearch12"
        },
        {
            "name": "macos-ci",
            "configurePreset": "macos-ci",
            "targets": "usearch12"
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release",
            "targets": "usearch12"
        }
    ]
}
